LINK_CONTEXT_URI="https://jsonld-contexts/file.jsonld"

# One row per realm. Do not repeat credentials per use case.
BLUEPRINT_UPDATE_REALM_CONFIG='[
    {
        "keycloakBaseUrl": "https://sso.example.fr",
        "gatewayServer": "https://tenantA.example.fr",
        "grantType": "client_credentials",
        "clientId": "example-team",
        "clientSecret": "12345",
        "realm": "tenantA",
        "tenant": "urn:ngsi-ld:tenant:tenantA"
    },
    {
        "keycloakBaseUrl": "https://sso.example.fr",
        "gatewayServer": "https://tenantB.example.fr",
        "grantType": "client_credentials",
        "clientId": "example-team",
        "clientSecret": "12345",
        "realm": "tenantB",
        "tenant": "urn:ngsi-ld:tenant:tenantB"
    }
]'
