{
    "display": "Node 24",
    "compilerOptions": {
        "lib": ["es2024"],
        "module": "nodenext",
        "target": "es2024",
        "moduleResolution": "nodenext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "dist",
        "baseUrl": "."
    },
    "include": ["src"]
}
